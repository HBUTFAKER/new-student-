.home {
  display: flex;
  flex-direction: column;
}

.home__head {
  padding: 8rpx 4rpx 28rpx;
}

.home__title {
  font-size: 40rpx;
  font-weight: 600;
}

.home__meta {
  margin-top: 10rpx;
}

.home__skeleton {
  display: flex;
  flex-direction: column;
}

.home__bar {
  height: 32rpx;
  border-radius: 8rpx;
  background: #eef0f3;
}

.home__bar + .home__bar {
  margin-top: 20rpx;
}

.home__bar--short {
  width: 45%;
}

.home__list {
  display: flex;
  flex-direction: column;
}

/* 不用 flex gap：安卓 X5 内核老版本不认，卡片会贴在一起 */
.student {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.student__avatar {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 50%;
  background: #e8f0ff;
  color: var(--brand);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.student__main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.student__name-row {
  display: flex;
  align-items: center;
}

.student__name {
  font-size: 32rpx;
  font-weight: 500;
}

.student__tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 100rpx;
  background: #e8f0ff;
  color: var(--brand);
  font-size: 20rpx;
}

.student__org {
  margin-top: 8rpx;
}

.student__relation {
  margin-left: 16rpx;
  color: var(--text-weak);
  font-size: 24rpx;
}

.student__switch {
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  border: 1rpx solid var(--brand);
  border-radius: 100rpx;
  color: var(--brand);
  font-size: 24rpx;
}

.student__switch--busy {
  border-color: transparent;
  color: var(--text-weak);
}

.home__error {
  margin-top: 0;
}

.home__retry {
  margin-top: 24rpx;
}

.home__empty {
  text-align: center;
  padding: 56rpx 28rpx;
}

.home__empty-title {
  font-size: 32rpx;
  font-weight: 500;
}

.home__empty-tip {
  margin-top: 12rpx;
  line-height: 1.6;
}

.home__hint {
  margin-top: 8rpx;
  text-align: center;
}

.home__footer {
  margin-top: auto;
  padding-top: 48rpx;
}
