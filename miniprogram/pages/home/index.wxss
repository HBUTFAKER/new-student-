.home {
  display: flex;
  flex-direction: column;
}

.home__head {
  padding: 8rpx 4rpx 28rpx;
}

.home__title {
  font-size: 40rpx;
  font-weight: 600;
}

.home__meta {
  margin-top: 10rpx;
}

.home__skeleton {
  display: flex;
  flex-direction: column;
}

.home__bar {
  height: 32rpx;
  border-radius: 8rpx;
  background: #eef0f3;
}

.home__bar + .home__bar {
  margin-top: 20rpx;
}

.home__bar--short {
  width: 45%;
}

/* 当前孩子卡 */
.child {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.child__avatar {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 50%;
  background: #e8f0ff;
  color: var(--brand);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 96rpx;
  text-align: center;
}

.child__main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.child__name {
  font-size: 34rpx;
  font-weight: 600;
}

.child__org {
  margin-top: 8rpx;
}

.child__action {
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  border: 1rpx solid var(--brand);
  border-radius: 100rpx;
  color: var(--brand);
  font-size: 24rpx;
}

/* 三个入口 */
.entries {
  margin-top: 24rpx;
}

/* 不用 flex gap：安卓 X5 老内核不认 */
.entry {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
}

.entry__main {
  flex: 1;
  min-width: 0;
}

.entry__title {
  font-size: 32rpx;
  font-weight: 500;
}

.entry__desc {
  margin-top: 8rpx;
}

.entry__arrow {
  margin-left: 16rpx;
  color: var(--text-weak);
  font-size: 40rpx;
  line-height: 1;
}

.home__error {
  margin-top: 0;
}

.home__retry {
  margin-top: 24rpx;
}

.home__empty {
  text-align: center;
  padding: 56rpx 28rpx;
}

.home__empty-title {
  font-size: 32rpx;
  font-weight: 500;
}

.home__empty-tip {
  margin-top: 12rpx;
  line-height: 1.6;
}

.home__footer {
  margin-top: auto;
  padding-top: 48rpx;
}
