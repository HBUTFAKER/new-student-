<view class="page messages">
  <view class="messages__head">
    <view class="messages__title">消息提醒</view>
    <view
      class="messages__all {{unread > 0 ? 'messages__all--active' : ''}}"
      bindtap="markAll"
    >
      {{marking ? '处理中…' : '全部已读'}}
    </view>
  </view>
  <view class="muted messages__meta" wx:if="{{total}}">
    共 {{total}} 条 · 未读 {{unread}} 条 · 下拉可刷新
  </view>

  <view wx:if="{{loading}}" class="card messages__skeleton">
    <view class="messages__bar"></view>
    <view class="messages__bar messages__bar--short"></view>
  </view>

  <view wx:elif="{{error}}" class="card">
    <view class="error-box messages__error">{{error}}</view>
    <button wx:if="{{errorAction === 'switch'}}" class="btn messages__retry" bindtap="goSwitch">
      重新选择孩子
    </button>
    <button wx:else class="btn btn--ghost messages__retry" bindtap="onRetry">重新加载</button>
  </view>

  <view wx:elif="{{items.length === 0}}" class="card messages__empty">
    <view class="messages__empty-title">暂无消息</view>
    <view class="muted messages__empty-tip">孩子签到扣课后，这里会收到提醒。</view>
  </view>

  <block wx:else>
    <view
      class="card msg {{item.unread ? 'msg--unread' : ''}}"
      wx:for="{{items}}"
      wx:key="id"
      data-index="{{index}}"
      bindtap="tapItem"
    >
      <view class="msg__top">
        <view class="msg__dot" wx:if="{{item.unread}}"></view>
        <view class="msg__title">{{item.title}}</view>
        <view class="muted msg__time">{{item.timeText}}</view>
      </view>
      <view class="msg__body">{{item.body}}</view>
    </view>

    <view wx:if="{{loadingMore}}" class="muted messages__more">加载中…</view>
    <view wx:elif="{{!hasMore}}" class="muted messages__more">没有更多了</view>
  </block>
</view>
