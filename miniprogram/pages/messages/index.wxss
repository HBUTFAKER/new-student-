.messages__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 8rpx;
}

.messages__title {
  font-size: 40rpx;
  font-weight: 600;
}

.messages__all {
  font-size: 26rpx;
  color: var(--text-weak);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
}

.messages__all--active {
  color: var(--brand);
  border-color: var(--brand);
}

.messages__meta {
  padding: 0 4rpx 20rpx;
}

.messages__skeleton {
  display: flex;
  flex-direction: column;
}

.messages__bar {
  height: 32rpx;
  border-radius: 8rpx;
  background: #eef0f3;
}

.messages__bar + .messages__bar {
  margin-top: 20rpx;
}

.messages__bar--short {
  width: 45%;
}

.messages__empty {
  text-align: center;
  padding: 64rpx 24rpx;
}

.messages__empty-title {
  font-size: 32rpx;
  font-weight: 600;
}

.messages__empty-tip {
  margin-top: 12rpx;
}

.messages__error {
  margin-top: 0;
}

.messages__retry {
  margin-top: 24rpx;
}

.messages__more {
  text-align: center;
  padding: 24rpx 0 8rpx;
  font-size: 26rpx;
}

.msg + .msg {
  margin-top: 20rpx;
}

.msg__top {
  display: flex;
  align-items: center;
}

.msg__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--danger);
  margin-right: 12rpx;
  flex: none;
}

.msg__title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg__time {
  font-size: 24rpx;
  margin-left: 16rpx;
  flex: none;
}

.msg__body {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--text-weak);
  line-height: 1.5;
}

.msg--unread .msg__title {
  color: var(--text);
}
