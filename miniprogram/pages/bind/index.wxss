.bind__head {
  padding: 16rpx 4rpx 32rpx;
}

.bind__title {
  font-size: 40rpx;
  font-weight: 600;
}

.bind__desc {
  margin-top: 12rpx;
  line-height: 1.6;
}

.bind__label {
  font-size: 26rpx;
  color: var(--text-weak);
}

.bind__input {
  margin-top: 16rpx;
  height: 104rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 40rpx;
  letter-spacing: 8rpx;
  text-align: center;
}

.bind__input:focus {
  border-color: var(--brand);
}

.bind__ph {
  color: #c2c7cf;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

.bind__row {
  display: flex;
  margin-top: 24rpx;
}

.bind__mini {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
}

.bind__mini + .bind__mini {
  margin-left: 20rpx;
}

.bind__submit {
  margin-top: 32rpx;
}

.bind__link {
  margin-top: 12rpx;
  color: var(--brand);
  font-size: 26rpx;
  text-decoration: underline;
}

.bind__foot {
  margin-top: 32rpx;
  padding: 0 8rpx;
  line-height: 1.6;
}
