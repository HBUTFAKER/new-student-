.weekbar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.weekbar__nav {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  color: var(--brand);
  font-size: 44rpx;
  border-radius: 50%;
  background: #f2f6ff;
}

.weekbar__center {
  flex: 1;
  text-align: center;
}

.weekbar__label {
  font-size: 32rpx;
  font-weight: 600;
}

.weekbar__range {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.schedule__skeleton {
  display: flex;
  flex-direction: column;
}

.schedule__bar {
  height: 32rpx;
  border-radius: 8rpx;
  background: #eef0f3;
}

.schedule__bar + .schedule__bar {
  margin-top: 20rpx;
}

.schedule__bar--short {
  width: 45%;
}

.schedule__error {
  margin-top: 0;
}

.schedule__retry {
  margin-top: 24rpx;
}

.schedule__empty {
  text-align: center;
  padding: 56rpx 28rpx;
}

.schedule__empty-title {
  font-size: 32rpx;
  font-weight: 500;
}

.schedule__empty-tip {
  margin-top: 12rpx;
}

.day {
  margin-bottom: 12rpx;
}

.day__head {
  display: flex;
  align-items: baseline;
  padding: 8rpx 4rpx 16rpx;
}

.day__date {
  font-size: 28rpx;
  font-weight: 600;
}

.day__weekday {
  margin-left: 12rpx;
  color: var(--text-weak);
  font-size: 24rpx;
}

/* 不用 flex gap：安卓 X5 老内核不认 */
.lesson {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
}

.lesson__time {
  flex: 0 0 150rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}

.lesson__main {
  flex: 1;
  min-width: 0;
}

.lesson__title-row {
  display: flex;
  align-items: center;
}

.lesson__class {
  font-size: 30rpx;
  font-weight: 500;
}

.lesson__badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 100rpx;
  background: #fff4e5;
  color: #b26a00;
  font-size: 20rpx;
}

.lesson__meta {
  margin-top: 8rpx;
}
