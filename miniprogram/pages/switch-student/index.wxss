.switch__head {
  padding: 8rpx 4rpx 28rpx;
}

.switch__title {
  font-size: 40rpx;
  font-weight: 600;
}

.switch__desc {
  margin-top: 12rpx;
  line-height: 1.6;
}

.switch__error {
  margin-top: 0;
  margin-bottom: 20rpx;
}

.switch__skeleton {
  display: flex;
  flex-direction: column;
}

.switch__bar {
  height: 32rpx;
  border-radius: 8rpx;
  background: #eef0f3;
}

.switch__bar + .switch__bar {
  margin-top: 20rpx;
}

.switch__bar--short {
  width: 45%;
}

.switch__list {
  display: flex;
  flex-direction: column;
}

.switch__item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.switch__item--active {
  border-color: var(--brand);
}

.switch__avatar {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 50%;
  background: #e8f0ff;
  color: var(--brand);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.switch__main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.switch__name-row {
  display: flex;
  align-items: center;
}

.switch__name {
  font-size: 32rpx;
  font-weight: 500;
}

.switch__tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 100rpx;
  background: #e8f0ff;
  color: var(--brand);
  font-size: 20rpx;
}

.switch__org {
  margin-top: 8rpx;
}

.switch__hint {
  color: var(--brand);
  font-size: 24rpx;
}

.switch__arrow {
  color: #c2c7cf;
  font-size: 40rpx;
  line-height: 1;
}

.switch__empty {
  text-align: center;
  padding: 56rpx 28rpx;
}

.switch__empty-title {
  font-size: 32rpx;
  font-weight: 500;
}

.switch__empty-tip {
  margin-top: 12rpx;
  line-height: 1.6;
}

.switch__bind {
  margin-top: 24rpx;
}
