.bind {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 140rpx;
  text-align: center;
}

.bind__icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #e8f0ff;
  color: var(--brand);
  font-size: 60rpx;
  line-height: 128rpx;
  text-align: center;
}

.bind__title {
  margin-top: 36rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.bind__desc {
  margin-top: 20rpx;
  padding: 0 24rpx;
  line-height: 1.7;
}

.bind__action {
  margin-top: 72rpx;
  width: 80%;
}

.bind__link {
  margin-top: 36rpx;
  text-decoration: underline;
}
