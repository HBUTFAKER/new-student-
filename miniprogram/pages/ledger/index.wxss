.ledger__head {
  padding: 8rpx 4rpx 24rpx;
}

.ledger__title {
  font-size: 40rpx;
  font-weight: 600;
}

.ledger__meta {
  margin-top: 10rpx;
}

.ledger__skeleton {
  display: flex;
  flex-direction: column;
}

.ledger__bar {
  height: 32rpx;
  border-radius: 8rpx;
  background: #eef0f3;
}

.ledger__bar + .ledger__bar {
  margin-top: 20rpx;
}

.ledger__bar--short {
  width: 45%;
}

.ledger__error {
  margin-top: 0;
}

.ledger__retry {
  margin-top: 24rpx;
}

.ledger__empty {
  text-align: center;
  padding: 56rpx 28rpx;
}

.ledger__empty-title {
  font-size: 32rpx;
  font-weight: 500;
}

.ledger__empty-tip {
  margin-top: 12rpx;
}

/* 不用 flex gap：安卓 X5 老内核不认 */
.row {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
}

.row__left {
  flex: 1;
  min-width: 0;
}

.row__type {
  font-size: 30rpx;
  font-weight: 500;
}

.row__meta {
  margin-top: 8rpx;
}

.row__delta {
  margin-left: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #0f9960;
}

.row__delta--minus {
  color: var(--danger);
}

.ledger__more {
  padding: 24rpx 0 8rpx;
  text-align: center;
}
