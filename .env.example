APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
DB_ECHO=false

# Authentication. Production must override JWT_SECRET_KEY.
JWT_SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=2592000

# WeChat mini program. Stub mode needs no real appid/secret (local/test/CI).
WECHAT_APP_ID=wx_platform_stub
WECHAT_APP_SECRET=
WECHAT_STUB_MODE=true

POSTGRES_DB=student
POSTGRES_USER=student
POSTGRES_PASSWORD=student_dev_password
APP_DB_PASSWORD=app_user_dev_password

# Runtime uses a non-superuser role so PostgreSQL RLS is actually enforced.
# Alembic uses the owner/superuser URL separately for DDL and role creation.
# docker compose overrides host "localhost" with "db".
DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev_password@localhost:5432/student
MIGRATION_DATABASE_URL=postgresql+asyncpg://student:student_dev_password@localhost:5432/student
