# =============================================================================
# 生产环境变量清单（7.6）
# 复制本文件为项目根目录 .env.prod 并填真实值：
#   cp deploy/env.prod.example .env.prod
# 然后：docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# 本清单与 app/core/config.py 的 Settings 字段一一对表，一个不落。
# 变量来源优先级：compose environment 覆盖 > env_file 注入 > 容器内 .env。
# =============================================================================

# ---------------------------------------------------------------------------
# 应用基础
# ---------------------------------------------------------------------------
# 生产必须为 production；config.py 会据此拒绝默认 JWT 密钥。
APP_ENV=production
# 生产必须 false。true 会暴露调试信息。
DEBUG=false
# 日志级别：DEBUG / INFO / WARNING / ERROR。
LOG_LEVEL=INFO
# SQL 回显：生产 false，避免把整条 SQL 打进日志。
DB_ECHO=false

# ---------------------------------------------------------------------------
# 认证（生产必改）
# ---------------------------------------------------------------------------
# 【必改】JWT 签名密钥。不填（沿用 dev 默认值）时 config.py 在 production 下直接拒绝启动。
# 生成方式：openssl rand -hex 32
JWT_SECRET_KEY=
# 签名算法，保持 HS256 即可。
JWT_ALGORITHM=HS256
# access token 有效期（秒），默认 2 小时。
ACCESS_TOKEN_TTL_SECONDS=7200
# refresh token 有效期（秒），默认 30 天。
REFRESH_TOKEN_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# 数据库（生产必改两处密码）
# ---------------------------------------------------------------------------
# 数据库名，默认 student 即可。
POSTGRES_DB=student
# 数据库 owner 账号（有 DDL / 角色管理权限，迁移用）。
POSTGRES_USER=student
# 【必改】owner 账号密码。不填会导致 db 初始化失败。
POSTGRES_PASSWORD=
# 【必改】app_user 运行时密码。app_user 是非超管角色，PostgreSQL RLS 靠它真正生效。
# 不填（沿用空值）会导致 api 连不上库。
APP_DB_PASSWORD=

# 说明：DATABASE_URL / MIGRATION_DATABASE_URL 由 docker-compose.prod.yml 自动拼装
# （指向 compose 内的 db 服务、双角色结构），无需在此填写。仅在本机直跑 uvicorn
# （不走 compose）时才需要手动填这两个变量。

# ---------------------------------------------------------------------------
# 微信小程序（保持 stub，不申请不配置）
# ---------------------------------------------------------------------------
# true = 桩模式，本地/测试/生产未接真实微信时都用这个。真实接入时才改 false。
WECHAT_STUB_MODE=true
# 桩模式无需真实值；真实接入填小程序 AppID。
WECHAT_APP_ID=
# 桩模式留空；真实接入填小程序 AppSecret（勿提交仓库）。
WECHAT_APP_SECRET=
# 订阅消息模板 JSON。桩模式用内置默认即可；真实接入从微信后台取模板 id 后覆写，例如：
# WECHAT_SUBSCRIBE_TEMPLATES=[{"template_id":"REAL_ID","type":"one_time","scene":"lesson_remind"},{"template_id":"REAL_ID2","type":"one_time","scene":"balance_warn"}]

# ---------------------------------------------------------------------------
# 服务号 / 短信（保持 stub）
# ---------------------------------------------------------------------------
# 服务号模板消息通道。app_id 留空 = 机构未配置 → 该通道整体不可用、静默跳过。
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_TEMPLATE_ID=
# 短信通道。sms_provider 留空 = 未配置供应商 → 通道不可用、静默跳过。
SMS_PROVIDER=
SMS_STUB_MODE=true

# ---------------------------------------------------------------------------
# 定时任务（单实例）
# ---------------------------------------------------------------------------
# 生产单实例：true。自写 asyncio 调度器（上课提醒 + 余额预警 + worker 循环）。
# 注意：多实例部署会导致任务重复跑——监控/多实例/调度锁是二期，本步单实例。
SCHEDULER_ENABLED=true
# 6.1 的通知 worker 开关。SCHEDULER_ENABLED=true 时它不生效（scheduler 优先接管）。
# 仅当 SCHEDULER_ENABLED=false 时，本开关才会启动纯 worker 循环。
NOTIFICATION_WORKER_ENABLED=true
# worker 轮询间隔（秒）。
NOTIFICATION_WORKER_INTERVAL_SECONDS=30
# 上课提醒扫描间隔（秒）。
LESSON_REMINDER_SCAN_INTERVAL_SECONDS=300
# 余额预警扫描间隔（秒）。
BALANCE_ALERT_SCAN_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------------
# 平台管理员初始化（生产首启必跑 scripts/init_platform_admin.py）
# ---------------------------------------------------------------------------
# 首个平台管理员手机号（登录账号）。
PLATFORM_ADMIN_PHONE=
# 首个平台管理员密码（强密码）。
PLATFORM_ADMIN_PASSWORD=
# 显示名，默认「平台管理员」。
PLATFORM_ADMIN_NAME=平台管理员

# ---------------------------------------------------------------------------
# 部署
# ---------------------------------------------------------------------------
# 对外 HTTP 端口（宿主 -> nginx 容器 80）。默认 80；若 80 被占用可改，例如 8080。
HTTP_PORT=80
